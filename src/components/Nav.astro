---
// Site navigation. The links are data, so adding a page means adding one line.
const links = [
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Projects", href: "#projects" },
  { label: "Leadership", href: "#leadership" },
  { label: "Milestones", href: "#milestones" },
  { label: "Beyond", href: "#beyond" },
  { label: "Contact", href: "#contact" },
];
---

<header class="nav">
  <a class="brand" href="/">Bhavika Kothapalli</a>
  <nav aria-label="Main">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <button class="mode" id="mode" type="button" aria-label="Switch to night">
      <!-- Moon: shown during golden hour -->
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
      </svg>
      <!-- Sun: shown at night -->
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
    </button>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 22px;
    color: var(--hero-fg);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.01em;
    text-decoration: none;
    padding-block: 10px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 22px;
    font-size: 15px;
  }

  nav a {
    color: var(--hero-muted);
    text-decoration: none;
    padding-block: 12px;
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--hero-fg);
  }

  /* The sun/moon button */
  .mode {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    display: inline-grid;
    place-items: center;
    padding: 0;
    cursor: pointer;
    color: var(--hero-fg);
    background: var(--glass);
    border: 1px solid var(--glass-line);
    backdrop-filter: blur(12px);
    transition: transform 0.25s;
  }

  .mode:hover {
    transform: rotate(-12deg);
  }

  .mode svg {
    width: 18px;
    height: 18px;
  }

  /* Show the moon by day, the sun by night */
  .sun {
    display: none;
  }

  :global(html[data-theme="dark"]) .sun {
    display: block;
  }

  :global(html[data-theme="dark"]) .moon {
    display: none;
  }
</style>
