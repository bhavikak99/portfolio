---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
---

<BaseLayout>
  <section class="hero">
    <div class="wrap">
      <Nav />
    </div>
  </section>
</BaseLayout>

<style>
  /* Temporary sky gradient. The 3D scene replaces it later. */
  .hero {
    min-height: 100svh;
    padding-inline: max(16px, env(safe-area-inset-left));
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-top) 35%, var(--sky-hor) 100%);
  }
</style>