---
// The 3D background. It sits behind the whole page.
---

<canvas id="scene" aria-hidden="true"></canvas>

<script>
  import { startScene } from "../scene/main.js";

  const canvas = document.getElementById("scene");
  startScene(canvas);
</script>

<style>
  #scene {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    display: block;
    /* The sky color behind the 3D. Later the 3D draws its own sky. */
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-top) 35%, var(--sky-hor) 100%);
  }
</style>